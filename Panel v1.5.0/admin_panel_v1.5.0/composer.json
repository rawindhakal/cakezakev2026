{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "beste/in-memory-cache": "^1.5",
        "brotzka/laravel-dotenv-editor": "^2.1",
        "doctrine/dbal": "^3.10",
        "google/apiclient": "^2.15.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "kreait/firebase-php": "^7.0",
        "laravel/framework": "^12.0",
        "laravel/passport": "^12.0",
        "laravel/reverb": "^1.10",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.5",
        "lcobucci/clock": "~3.5.0",
        "maatwebsite/excel": "4.x-dev",
        "maennchen/zipstream-php": "^2.4",
        "midtrans/midtrans-php": "^2.5",
        "mpdf/mpdf": "^8.1",
        "phpoffice/phpspreadsheet": "^5.5.0",
        "psr/http-message": "^1.0",
        "pusher/pusher-php-server": "^7.2",
        "rap2hpoutre/laravel-log-viewer": "^2.2",
        "razorpay/razorpay": "2.*",
        "spatie/laravel-ignition": "^2.0",
        "spatie/laravel-permission": "^6.0",
        "spatie/laravel-translatable": "^6.12 <6.15",
        "stripe/stripe-php": "^20.3",
        "twilio/sdk": "^7.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.2",
        "fakerphp/faker": "^1.9.1",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.5",
        "phpunit/phpunit": "^11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Twilio\\": "vendor/twilio/sdk/src/Twilio"
        },
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-autoload-dump": "Google\\Task\\Composer::cleanup"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "google/apiclient-services": [
            "FirebaseCloudMessaging"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
